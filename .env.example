# Copie a .env (o use scripts/generate-env.sh, que genera secretos aleatorios).
ZULIP_EXTERNAL_HOST=localhost
ZULIP_ADMINISTRATOR=admin@example.com
ZULIP_CERTIFICATES=self-signed
ZULIP_BIND_ADDRESS=127.0.0.1

ZULIP__POSTGRES_PASSWORD=changeme-postgres
ZULIP__MEMCACHED_PASSWORD=changeme-memcached
ZULIP__RABBITMQ_PASSWORD=changeme-rabbitmq
ZULIP__REDIS_PASSWORD=changeme-redis
ZULIP__SECRET_KEY=changeme-secret-key
ZULIP__EMAIL_PASSWORD=changeme-email
